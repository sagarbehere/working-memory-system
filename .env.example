# Working-memory runtime config. Copied to ~/.hermes/working-memory.env by
# setup.sh and never overwritten afterwards. These are the agreed defaults
# (spec Section 14 open items) — tune after a few weeks of real use.
WM_ROOT=~/working-memory
# Obsidian vault (typed notes). The nightly backup watchdog checks this repo
# is in sync, so a wrong path means a nightly alert.
WM_VAULT_PATH=~/wiki
WM_DEBOUNCE_SECONDS=5
WM_RAW_RETENTION_DAYS=90
WM_CONFIRM=1
# Timezone for user-facing timestamps (IANA name, e.g. Asia/Kolkata). Leave
# empty to use the machine's zone. Stored timestamps are normalised to UTC
# regardless — this only affects how times are displayed and how a naive
# timestamp is interpreted.
# WM_TZ=
# Skill auto-loaded into the WM lane's session (deterministic: the hook
# stamps every buffered event with this so the gateway injects the skill
# on new sessions; no reliance on the model choosing to load it).
WM_SKILL=working-memory
# Legacy lane (optional seed — see spec: Scope boundary): the env-declared
# chat behaves as one pre-reserved lane where markers are implied. The gate
# also accepts in-chat reservation ("reserve for memory" -> $WM_ROOT/meta/
# lanes.json, released with "release for memory") on ANY platform, and
# marker mode ("Hey memory" / "note" prefix) works with zero config at
# all. Empty = no legacy lane. Two legacy shapes are supported:
#   - a DM topic lane with this bot: set chat id + thread id (see below)
#   - a private group containing only you + the bot: set the group chat id
#     (and make sure the bot is allowed there — see README)
WM_TELEGRAM_CHAT_ID=
# WM_TELEGRAM_THREAD_ID=   # set when the WM chat is a DM-topic lane

# --- Todoist: the reminder mechanism (required for reminders) ---
# Without a token, captures and notes still work but reminders cannot be
# set at all — nothing fires from this machine. The variable is named
# 'MIRROR' for historical reasons; Todoist is the sole reminder layer.
# TODOIST_API_TOKEN=  # put the real token in ~/.hermes/.env
# TODOIST_MIRROR_ENABLED=true
# TODOIST_PROJECT=Hermes
